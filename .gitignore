# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Packaging
*.egg-info/
build/
dist/

# Runtime artefacts
node_modules/
.venv/
venv/

# Evaluation and benchmark output. Results are reproducible from the case
# definitions plus a runtime, so they are not committed.
runs/
results/
*.report.html

# Generated eval fixtures. These are derivable from the case corpus by
# tools/build-fixtures.py, and one of them is 48,000 lines of JSON Lines.
# Committing them would mean two sources of truth for the same data, which is
# the failure mode the corpus's own numbers already caused once.
.eval-fixtures/

# Local agent state
.memory/

# Run state written by the kernel itself. Step 0 opens with
# `run-state.py init --rung ...`, so following the kernel from the skill root
# drops a directory here on every run -- which means obeying the kernel dirties
# the working tree, and the next person cannot tell that from an agent editing
# files. testbed/.ultimate-dev/run-state.json is already tracked as a fixture
# and stays tracked: ignoring a directory does not untrack what is in it.
.ultimate-dev/

# OS
.DS_Store
Thumbs.db

# Workflow runtime outputs and task artefacts
.agents/
.agents/tasks/
**/.memory/
**/.ultimate-dev/
*.run-state.json
/review.json
/plan.md
/review.md

# Fixture debris. build-fixtures.py stages into the repository because the
# runtime ignores the per-invocation working directory, so these appear at the
# root during a pilot run and must never be committed.
/config.py
/other.py
/docs/draft/
/.eval-fixtures/
/runs/

# Python bytecode cache. tools/*.py import nothing from a package, so running
# any of them drops a __pycache__ next to the source; without this they show up
# as untracked noise in git status.
__pycache__/
*.py[cod]
.agents