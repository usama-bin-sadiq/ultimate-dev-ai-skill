# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Packaging
*.egg-info/
build/
dist/

# Runtime artefacts
node_modules/
.venv/
venv/

# Evaluation and benchmark output. Results are reproducible from the case
# definitions plus a runtime, so they are not committed.
runs/
results/
*.report.html

# Generated eval fixtures. These are derivable from the case corpus by
# tools/build-fixtures.py, and one of them is 48,000 lines of JSON Lines.
# Committing them would mean two sources of truth for the same data, which is
# the failure mode the corpus's own numbers already caused once.
.eval-fixtures/

# Local agent state
.memory/

# OS
.DS_Store
Thumbs.db

# Fixture debris. build-fixtures.py stages into the repository because the
# runtime ignores the per-invocation working directory, so these appear at the
# root during a pilot run and must never be committed.
/config.py
/other.py
/docs/draft/
/.eval-fixtures/
/runs/

# Upstream catalogue clones. Fetched, not committed: a few hundred megabytes
# of other people's repositories, each with its own .git directory, and fully
# reproducible from catalog/fetch-catalog.sh. The derived output -- INDEX.json and
# OVERLAPS.json -- IS committed, because that is what says what was fetched and
# what it turned out to be.
/ultimate-dev/catalog/_src/
