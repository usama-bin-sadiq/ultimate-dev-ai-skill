# Byte-compiled / cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Packaging
*.egg-info/
build/
dist/

# Runtime artefacts
node_modules/
.venv/
venv/

# Evaluation and benchmark output. Results are reproducible from the case
# definitions plus a runtime, so they are not committed.
runs/
results/
*.report.html

# Generated eval fixtures. These are derivable from the case corpus by
# tools/build-fixtures.py, and one of them is 48,000 lines of JSON Lines.
# Committing them would mean two sources of truth for the same data, which is
# the failure mode the corpus's own numbers already caused once.
.eval-fixtures/

# Local agent state
.memory/

# OS
.DS_Store
Thumbs.db
