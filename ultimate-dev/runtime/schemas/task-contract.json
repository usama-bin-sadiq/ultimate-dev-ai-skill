{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultimate-Dev Task Contract",
  "type": "object",
  "required": [
    "goal"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "definition_of_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}