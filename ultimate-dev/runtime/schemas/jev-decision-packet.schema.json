{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultimate-dev:jev:decision-packet:1.0",
  "title": "Ultimate-Dev JEV Decision Packet",
  "description": "A deterministic, side-effect-free result consumed and persisted by the Ultimate-Dev runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "orchestration_state_id",
    "capability_catalog_version",
    "policy_version",
    "ok",
    "execution_effect",
    "errors",
    "heads",
    "aggregate",
    "guardrail",
    "route",
    "capability_plan",
    "context_plan",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "orchestration_state_id": {
      "type": ["string", "null"]
    },
    "capability_catalog_version": {
      "type": ["string", "null"]
    },
    "policy_version": {
      "type": ["string", "null"]
    },
    "ok": {
      "type": "boolean"
    },
    "execution_effect": {
      "type": "string",
      "enum": [
        "execute",
        "review",
        "clarify",
        "stop"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "heads": {
      "$ref": "#/$defs/heads"
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reasons"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "approve",
            "human_review",
            "deny"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "path",
        "task_size",
        "primary_domain",
        "reasons",
        "authority"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "inline",
            "subagent",
            "handoff",
            "router",
            "compose"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            "lightweight",
            "flagship",
            "human_review",
            "none"
          ]
        },
        "task_size": {
          "type": "string",
          "enum": [
            "atomic",
            "moderate",
            "complex"
          ]
        },
        "primary_domain": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "const": "recommendation"
        }
      }
    },
    "capability_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "omitted", "missing_capabilities"],
      "properties": {
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "code", "message"],
            "properties": {
              "id": {
                "$ref": "#/$defs/capabilityId"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "missing_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        }
      }
    },
    "context_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "reasons", "authority"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "deep"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "const": "recommendation"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_applied", "deterministic"],
      "properties": {
        "rules_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "capability_ids"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "path": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        }
      }
    },
    "heads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noul", "choice", "score"],
      "properties": {
        "noul": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgent",
            "destructive",
            "policy_sensitive",
            "human_approval_required",
            "evidence_required"
          ],
          "properties": {
            "urgent": {"type": "boolean"},
            "destructive": {"type": "boolean"},
            "policy_sensitive": {"type": "boolean"},
            "human_approval_required": {"type": "boolean"},
            "evidence_required": {"type": "boolean"}
          }
        },
        "choice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "task_size", "preferred_path", "primary_domain"],
          "properties": {
            "pattern": {
              "type": "string",
              "enum": ["inline", "subagent", "handoff", "router", "compose"]
            },
            "task_size": {
              "type": "string",
              "enum": ["atomic", "moderate", "complex"]
            },
            "preferred_path": {
              "type": "string",
              "enum": ["lightweight", "flagship", "human_review", "none"]
            },
            "primary_domain": {
              "type": "string"
            }
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk",
            "complexity",
            "urgency",
            "confidence",
            "context_pressure"
          ],
          "properties": {
            "risk": {"type": "number", "minimum": 0, "maximum": 1},
            "complexity": {"type": "number", "minimum": 0, "maximum": 1},
            "urgency": {"type": "number", "minimum": 0, "maximum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "context_pressure": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "complexity",
        "urgency",
        "confidence",
        "context_pressure",
        "load"
      ],
      "properties": {
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "complexity": {"type": "number", "minimum": 0, "maximum": 1},
        "urgency": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "context_pressure": {"type": "number", "minimum": 0, "maximum": 1},
        "load": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
