{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultimate-dev:jev:decision-packet:1.0",
  "title": "Ultimate-Dev JEV Decision Packet",
  "description": "A deterministic, side-effect-free result consumed and persisted by the Ultimate-Dev runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "orchestration_state_id",
    "capability_catalog_version",
    "policy_version",
    "ok",
    "execution_effect",
    "errors",
    "heads",
    "aggregate",
    "guardrail",
    "route",
    "capability_plan",
    "context_plan",
    "trace"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "orchestration_state_id": {
      "type": ["string", "null"]
    },
    "capability_catalog_version": {
      "type": ["string", "null"]
    },
    "policy_version": {
      "type": ["string", "null"]
    },
    "ok": {
      "type": "boolean"
    },
    "execution_effect": {
      "type": "string",
      "enum": [
        "execute",
        "review",
        "clarify",
        "stop"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reason"
      }
    },
    "heads": {
      "$ref": "#/$defs/heads"
    },
    "aggregate": {
      "$ref": "#/$defs/aggregate"
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "reasons"],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "approve",
            "human_review",
            "deny"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "path",
        "task_size",
        "primary_domain",
        "reasons",
        "authority"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "inline",
            "subagent",
            "handoff",
            "router",
            "compose"
          ]
        },
        "path": {
          "type": "string",
          "enum": [
            "lightweight",
            "flagship",
            "human_review",
            "none"
          ]
        },
        "task_size": {
          "type": "string",
          "enum": [
            "atomic",
            "moderate",
            "complex"
          ]
        },
        "primary_domain": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "const": "recommendation"
        }
      }
    },
    "capability_plan": {
      "description": "Executable packets require a non-empty selected set with no missing capabilities; semantic validation must also prove that selected descriptors cover every proposed effect.",
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "omitted", "missing_capabilities"],
      "properties": {
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "omitted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "code", "message"],
            "properties": {
              "id": {
                "$ref": "#/$defs/capabilityId"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "missing_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        }
      }
    },
    "context_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "reasons", "authority"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "deep"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authority": {
          "const": "recommendation"
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_applied", "deterministic"],
      "properties": {
        "rules_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deterministic": {
          "const": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["execution_effect"],
        "properties": {
          "execution_effect": {
            "const": "execute"
          }
        }
      },
      "then": {
        "properties": {
          "ok": {
            "const": true
          },
          "errors": {
            "maxItems": 0
          },
          "guardrail": {
            "properties": {
              "action": {
                "const": "approve"
              }
            }
          },
          "route": {
            "properties": {
              "path": {
                "enum": ["lightweight", "flagship"]
              }
            }
          },
          "capability_plan": {
            "properties": {
              "selected": {
                "minItems": 1
              },
              "missing_capabilities": {
                "maxItems": 0
              }
            }
          }
        },
        "not": {
          "properties": {
            "guardrail": {
              "properties": {
                "reasons": {
                  "contains": {
                    "required": ["code"],
                    "properties": {
                      "code": {
                        "enum": [
                          "approval_required",
                          "approval_expired",
                          "approval_future_dated",
                          "approval_invalid",
                          "approval_scope_mismatch",
                          "approval_stale",
                          "approval_window_too_long",
                          "evaluation_time_required",
                          "capability_budget_insufficient",
                          "capability_effect_not_declared",
                          "destructive_effect",
                          "destructive_signal",
                          "effect_coverage_incomplete",
                          "high_risk",
                          "human_approval_required",
                          "irreversible_or_unknown",
                          "low_confidence",
                          "missing_isolation",
                          "missing_required_evidence",
                          "model_requested_review",
                          "policy_review_capability",
                          "policy_denied_capability",
                          "policy_denied_effect",
                          "policy_sensitive",
                          "production_side_effect",
                          "required_capability_unavailable",
                          "invalid_request"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["execution_effect"],
        "properties": {
          "execution_effect": {
            "enum": ["review", "clarify", "stop"]
          }
        }
      },
      "then": {
        "properties": {
          "capability_plan": {
            "properties": {
              "selected": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["guardrail"],
        "properties": {
          "guardrail": {
            "required": ["action"],
            "properties": {
              "action": {
                "const": "deny"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_effect": {
            "const": "stop"
          }
        }
      }
    },
    {
      "if": {
        "required": ["guardrail"],
        "properties": {
          "guardrail": {
            "required": ["action"],
            "properties": {
              "action": {
                "const": "human_review"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_effect": {
            "const": "review"
          }
        }
      }
    },
    {
      "if": {
        "required": ["heads"],
        "properties": {
          "heads": {
            "required": ["noul"],
            "properties": {
              "noul": {
                "required": ["destructive"],
                "properties": {
                  "destructive": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_effect": {
            "enum": ["review", "clarify", "stop"]
          },
          "guardrail": {
            "properties": {
              "action": {
                "enum": ["human_review", "deny"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["execution_effect"],
        "properties": {
          "execution_effect": {
            "const": "stop"
          }
        }
      },
      "then": {
        "properties": {
          "guardrail": {
            "properties": {
              "action": {
                "const": "deny"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["guardrail"],
        "properties": {
          "guardrail": {
            "required": ["action"],
            "properties": {
              "action": {
                "const": "approve"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "execution_effect": {
            "enum": ["execute", "clarify"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["ok"],
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "capability_ids"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "path": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        }
      }
    },
    "heads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["noul", "choice", "score"],
      "properties": {
        "noul": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "urgent",
            "destructive",
            "policy_sensitive",
            "human_approval_required",
            "evidence_required"
          ],
          "properties": {
            "urgent": {"type": "boolean"},
            "destructive": {"type": "boolean"},
            "policy_sensitive": {"type": "boolean"},
            "human_approval_required": {"type": "boolean"},
            "evidence_required": {"type": "boolean"}
          }
        },
        "choice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern", "task_size", "preferred_path", "primary_domain"],
          "properties": {
            "pattern": {
              "type": "string",
              "enum": ["inline", "subagent", "handoff", "router", "compose"]
            },
            "task_size": {
              "type": "string",
              "enum": ["atomic", "moderate", "complex"]
            },
            "preferred_path": {
              "type": "string",
              "enum": ["lightweight", "flagship", "human_review", "none"]
            },
            "primary_domain": {
              "type": "string"
            }
          }
        },
        "score": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "risk",
            "complexity",
            "urgency",
            "confidence",
            "context_pressure"
          ],
          "properties": {
            "risk": {"type": "number", "minimum": 0, "maximum": 1},
            "complexity": {"type": "number", "minimum": 0, "maximum": 1},
            "urgency": {"type": "number", "minimum": 0, "maximum": 1},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "context_pressure": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "complexity",
        "urgency",
        "confidence",
        "context_pressure",
        "load"
      ],
      "properties": {
        "risk": {"type": "number", "minimum": 0, "maximum": 1},
        "complexity": {"type": "number", "minimum": 0, "maximum": 1},
        "urgency": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "context_pressure": {"type": "number", "minimum": 0, "maximum": 1},
        "load": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
