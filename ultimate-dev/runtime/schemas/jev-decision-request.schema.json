{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ultimate-dev:jev:decision-request:1.0",
  "title": "Ultimate-Dev JEV Decision Request",
  "description": "A side-effect-free decision request. The model proposes; the host supplies capabilities, policy, and approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "orchestration_state",
    "model_assessment",
    "host_facts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "orchestration_state": {
      "$ref": "#/$defs/orchestrationState"
    },
    "model_assessment": {
      "$ref": "#/$defs/modelAssessment"
    },
    "host_facts": {
      "$ref": "#/$defs/hostFacts"
    }
  },
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 200
    },
    "effect": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "execute",
        "delete",
        "network",
        "communicate"
      ]
    },
    "orchestrationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "pattern",
        "phase",
        "environment",
        "completed_step_ids",
        "pending_step_ids"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pattern": {
          "type": "string",
          "enum": [
            "undecided",
            "inline",
            "subagent",
            "handoff",
            "router",
            "compose"
          ]
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "environment": {
          "type": "string",
          "enum": [
            "development",
            "test",
            "staging",
            "production",
            "unknown"
          ]
        },
        "completed_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "pending_step_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "modelAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signals",
        "choice",
        "scores",
        "proposal"
      ],
      "properties": {
        "signals": {
          "$ref": "#/$defs/noul"
        },
        "choice": {
          "$ref": "#/$defs/choice"
        },
        "scores": {
          "$ref": "#/$defs/score"
        },
        "proposal": {
          "$ref": "#/$defs/proposal"
        }
      }
    },
    "noul": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "urgent",
        "destructive",
        "policy_sensitive",
        "human_approval_required",
        "evidence_required"
      ],
      "properties": {
        "urgent": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "policy_sensitive": {
          "type": "boolean"
        },
        "human_approval_required": {
          "type": "boolean"
        },
        "evidence_required": {
          "type": "boolean"
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern",
        "task_size",
        "preferred_path",
        "primary_domain",
        "rationale"
      ],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "inline",
            "subagent",
            "handoff",
            "router",
            "compose"
          ]
        },
        "task_size": {
          "type": "string",
          "enum": [
            "atomic",
            "moderate",
            "complex"
          ]
        },
        "preferred_path": {
          "type": "string",
          "enum": [
            "lightweight",
            "flagship",
            "human_review",
            "none"
          ]
        },
        "primary_domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk",
        "complexity",
        "urgency",
        "confidence",
        "context_pressure"
      ],
      "properties": {
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "complexity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "urgency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "context_pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "action",
        "requested_capabilities",
        "effects",
        "evidence_refs"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "requested_capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRequest"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "reversibility", "scope"],
      "properties": {
        "operation": {
          "$ref": "#/$defs/effect"
        },
        "reversibility": {
          "type": "string",
          "enum": [
            "reversible",
            "partially_reversible",
            "irreversible",
            "unknown"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "project_root", "targets"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "project_root": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "reason"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "hostFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_catalog_version",
        "capability_catalog",
        "policy",
        "approvals"
      ],
      "properties": {
        "capability_catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capability_catalog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityDescriptor"
          }
        },
        "policy": {
          "$ref": "#/$defs/policy"
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    "capabilityDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "available",
        "reversible",
        "isolation",
        "risk",
        "effects"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/capabilityId"
        },
        "available": {
          "type": "boolean"
        },
        "reversible": {
          "type": "boolean"
        },
        "isolation": {
          "type": "string",
          "enum": [
            "host_managed",
            "user_approved",
            "none"
          ]
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/effect"
          },
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "denied_capability_ids",
        "review_capability_ids",
        "denied_effects",
        "approval_required_effects",
        "isolation_required_effects",
        "thresholds",
        "max_capabilities"
      ],
      "properties": {
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "denied_capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "review_capability_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityId"
          },
          "uniqueItems": true
        },
        "denied_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "uniqueItems": true
        },
        "approval_required_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "uniqueItems": true
        },
        "isolation_required_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effect"
          },
          "uniqueItems": true
        },
        "thresholds": {
          "$ref": "#/$defs/thresholds"
        },
        "max_capabilities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_risk",
        "review_confidence",
        "flagship_load",
        "high_context_pressure",
        "deep_complexity",
        "deep_confidence"
      ],
      "properties": {
        "review_risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flagship_load": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_context_pressure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deep_complexity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "deep_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "effect",
        "scope",
        "confirmed_at"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "effect": {
          "$ref": "#/$defs/effect"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
