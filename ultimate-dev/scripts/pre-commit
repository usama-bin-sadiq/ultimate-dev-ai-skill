#!/bin/bash
# ultimate-dev v2.0.0 — Pre-commit Validation Hook
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or: ln -sf ../../scripts/pre-commit .git/hooks/pre-commit

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# If running from .git/hooks, go up to repo root
if [[ "$SCRIPT_DIR" == *".git/hooks" ]]; then
    REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
    REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

echo "🔍 ultimate-dev v2.0.0 — Pre-commit Validation"
echo "================================================"

# Only validate if skill files are being committed
SKILL_FILES=$(git diff --cached --name-only | grep -E "(SKILL\.md|skill-manifest\.yaml|agents/|skills/|modules/)" || true)

if [ -z "$SKILL_FILES" ]; then
    echo "No skill files changed — skipping validation."
    exit 0
fi

echo "Changed skill files detected:"
echo "$SKILL_FILES" | sed 's/^/  /'
echo ""

# Run validation
cd "$REPO_ROOT"
if python3 scripts/validate.py; then
    echo ""
    echo "✅ Pre-commit validation passed."
    exit 0
else
    echo ""
    echo "❌ Pre-commit validation FAILED."
    echo "Fix the issues above before committing."
    echo "Or run: git commit --no-verify (NOT recommended)"
    exit 1
fi
