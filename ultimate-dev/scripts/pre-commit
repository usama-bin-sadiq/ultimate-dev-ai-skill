#!/bin/bash
# ultimate-dev — Pre-commit Validation Hook (version comes from VERSION)
# Install from the repo root:
#   cp ultimate-dev/scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or symlink it:
#   ln -sf ../../ultimate-dev/scripts/pre-commit .git/hooks/pre-commit

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# The hook may run from .git/hooks (copied or symlinked) or directly from
# ultimate-dev/scripts/. Either way, locate the skill dir (the dir that
# contains SKILL.md, VERSION, scripts/sync-docs.py, scripts/validate.py).
if [[ "$SCRIPT_DIR" == *".git/hooks" ]]; then
    REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
    SKILL_DIR="$REPO_ROOT/ultimate-dev"
    if [ ! -d "$SKILL_DIR" ]; then
        SKILL_DIR="$REPO_ROOT"   # flat layout: everything sits at the repo root
    fi
else
    SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

VERSION=$(cat "$SKILL_DIR/VERSION" 2>/dev/null || echo "unknown")

echo "🔍 ultimate-dev v${VERSION} — Pre-commit Validation"
echo "================================================"

# Only validate if skill files (or the facts they drive) are being committed
SKILL_FILES=$(git diff --cached --name-only | grep -E "(SKILL\.md|skill-manifest\.yaml|README\.md|VERSION|agents/|skills/|modules/|contracts/|evals/|router/classification-rules\.md|config/capability-index\.yaml)" || true)

if [ -z "$SKILL_FILES" ]; then
    echo "No skill files changed — skipping validation."
    exit 0
fi

echo "Changed skill files detected:"
echo "$SKILL_FILES" | sed 's/^/  /'
echo ""

cd "$SKILL_DIR"

# 1. README numbers must match VERSION and what is actually on disk
if ! python3 scripts/sync-docs.py --check; then
    echo ""
    echo "❌ README.md is out of sync with the repo."
    echo "Fix: python3 scripts/sync-docs.py   (then stage README.md again)"
    exit 1
fi
echo ""

# 2. Provider-free routing fixture audit
python3 scripts/benchmark-prompt-routing.py --strict >/dev/null
python3 scripts/audit-prompt-suite.py --strict >/dev/null

# 3. Full validation
if python3 scripts/validate.py; then
    echo ""
    echo "✅ Pre-commit validation passed."
    exit 0
else
    echo ""
    echo "❌ Pre-commit validation FAILED."
    echo "Fix the issues above before committing."
    echo "Or run: git commit --no-verify (NOT recommended)"
    exit 1
fi
